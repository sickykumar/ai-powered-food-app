# Backend Environment Configuration Template
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/food_app

MODE=DEVELOPMENT
PORT=8080

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES=7d
JWT_EXPIRE=7d
JWT_EXPIRES_TIME=7

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

FRONTEND_URL=https://food.sickykumar.in
BACKEND_URL=https://api-food.sickykumar.in

STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_API_KEY=your_stripe_api_key

EMAIL_USERNAME=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=25
EMAIL_FROM=orderit.com

GROQ_API_KEY=your_groq_api_key
